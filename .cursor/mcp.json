{
  "mcpServers": {
    "swarm-data": {
      "command": "uvx",
      "args": [
        "--from",
        "quant-swarm",
        "swarm-data-mcp"
      ],
      "env": {
        "SWARM_MCP_ACCESS_TOKEN": "<token from https://1.21initiative.com/>"
      }
    },
    "swarm-warden": {
      "command": "uvx",
      "args": [
        "--from",
        "quant-swarm",
        "swarm-warden-mcp"
      ],
      "env": {
        "SWARM_MCP_ACCESS_TOKEN": "<token from https://1.21initiative.com/>"
      }
    },
    "swarm-gym": {
      "command": "uvx",
      "args": [
        "--from",
        "quant-swarm",
        "swarm-gym-mcp"
      ],
      "env": {
        "SWARM_MCP_ACCESS_TOKEN": "<token from https://1.21initiative.com/>"
      }
    }
  }
}
